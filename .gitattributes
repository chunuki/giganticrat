## Unity-specific line ending rules ##

# Handle all text files
* text=auto

# Force C# scripts and shaders to LF
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf

# Force Unity's YAML files to LF (Scenes, Prefabs, etc.)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
